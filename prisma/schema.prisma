// Prisma Schema for Bank Sampah / Pemilahan Sampah
// Fully compliant with assignment requirements & Google Form criteria

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  warga
}

enum TipeSaldo {
  kredit
  debit
}

enum JenisPenukaran {
  uang_tunai
  reward
}

enum StatusPenukaran {
  menunggu
  disetujui
  ditolak
}

model User {
  id        String   @id @default(uuid())
  nama      String   // Wajib (tidak pakai ?)
  email     String   @unique
  noHp      String   @unique
  password  String   @default("password123")
  alamat    String?
  role      Role     @default(warga)
  foto      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  laporanSampah  LaporanSampah[]
  saldoLog       SaldoLog[]
  penukaranWarga Penukaran[]     @relation("PenukaranWarga")
  penukaranProses Penukaran[]    @relation("PenukaranAdmin")
  feedbackWarga  FeedbackWarga[]

  @@map("User")
}

model JenisSampah {
  id              String   @id @default(uuid())
  namaJenis       String   @unique
  hargaPerKg      Decimal  @db.Decimal(10, 2)
  satuan          String   @default("kg")
  bisaDidaurUlang Boolean  @default(true)
  keterangan      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  laporanSampah LaporanSampah[]

  @@map("JenisSampah")
}

model Wilayah {
  id          String   @id @default(uuid())
  namaWilayah String   @unique
  kodeWilayah String   @unique
  deskripsi   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  laporanSampah LaporanSampah[]

  @@map("Wilayah")
}

model LaporanSampah {
  id            String   @id @default(uuid())
  kodeSetor     String   @unique @default(uuid())
  beratKg       Decimal  @db.Decimal(8, 3)
  hargaSnapshot Decimal  @db.Decimal(10, 2)
  subtotalPoin  Decimal  @db.Decimal(10, 2)
  catatan       String?
  tanggalSetor  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jenisSampahId String
  jenisSampah   JenisSampah @relation(fields: [jenisSampahId], references: [id], onDelete: Restrict)

  wilayahId String
  wilayah   Wilayah @relation(fields: [wilayahId], references: [id], onDelete: Restrict)

  fotoSampah FotoSampah?

  @@map("LaporanSampah")
}

model FotoSampah {
  id        String   @id @default(uuid())
  urlFoto   String
  ukuranKb  Int?
  tipeFile  String?
  createdAt DateTime @default(now())

  laporanId     String        @unique
  laporanSampah LaporanSampah @relation(fields: [laporanId], references: [id], onDelete: Cascade)

  @@map("FotoSampah")
}

model SaldoLog {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipe         TipeSaldo
  jumlah       Decimal   @db.Decimal(10, 2)
  referensiId  String?
  referensiTipe String?  // "setor" | "penukaran"
  keterangan   String
  createdAt    DateTime  @default(now())

  @@map("SaldoLog")
}

model Penukaran {
  id               String          @id @default(uuid())
  idWarga          String
  warga            User            @relation("PenukaranWarga", fields: [idWarga], references: [id], onDelete: Cascade)
  jumlahPoin       Decimal         @db.Decimal(10, 2)
  jenis            JenisPenukaran
  keteranganReward String?
  status           StatusPenukaran @default(menunggu)
  idAdminProses    String?
  adminProses      User?           @relation("PenukaranAdmin", fields: [idAdminProses], references: [id], onDelete: SetNull)
  rewardId         String?
  reward           Reward?         @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  processedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("Penukaran")
}

model Reward {
  id             String   @id @default(uuid())
  nama           String
  poinDibutuhkan Decimal  @db.Decimal(10, 2)
  stok           Int      @default(0)
  aktif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  penukaran      Penukaran[]

  @@map("Reward")
}

model KegiatanKomunitas {
  id        String   @id @default(uuid())
  judul     String
  deskripsi String
  tanggal   DateTime
  lokasi    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("KegiatanKomunitas")
}

model FeedbackWarga {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  judul       String
  isiFeedback String
  status      String   @default("pending") // "pending" | "dibaca" | "ditindaklanjuti"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("FeedbackWarga")
}
